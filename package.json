{
    "name": "vedic-astrology-calculator",
    "version": "1.0.0",
    "description": "Comprehensive Vedic Astrology Calculation Library for Node.js",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "start": "node dist/server.js",
        "start:prod": "NODE_ENV=production node dist/server.js",
        "dev": "nodemon --exec ts-node src/server.ts",
        "dev:watch": "nodemon --exec ts-node src/server.ts",
        "api": "ts-node src/server.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "migrate": "ts-node src/database/migrate.ts",
        "db:reset": "ts-node src/database/reset_db.ts",
        "pm2:start": "pm2 start ecosystem.config.js --env production",
        "pm2:stop": "pm2 stop ecosystem.config.js",
        "pm2:restart": "pm2 restart ecosystem.config.js",
        "pm2:logs": "pm2 logs astroweb-api"
    },
    "keywords": [
        "astrology",
        "vedic",
        "jyotish",
        "horoscope",
        "panchang",
        "dasha",
        "birth-chart"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "astronomia": "^3.0.0",
        "axios": "^1.13.4",
        "bcrypt": "^5.1.1",
        "better-sqlite3": "^12.6.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dayjs": "^1.11.19",
        "dotenv": "^16.3.1",
        "ejs": "^4.0.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.0",
        "express-validator": "^7.3.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "moment-timezone": "^0.6.0",
        "morgan": "^1.10.1",
        "mysql2": "^3.16.3",
        "node-cache": "^5.1.2",
        "pdfkit": "^0.17.2",
        "puppeteer": "^24.37.3",
        "react-date-object": "^2.1.9",
        "reflect-metadata": "^0.2.2",
        "sequelize": "^6.37.7",
        "sequelize-typescript": "^2.1.6",
        "suncalc": "^1.9.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.0",
        "@types/node-cache": "^4.1.3",
        "@types/pdfkit": "^0.17.5",
        "@types/sequelize": "^4.28.20",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^9.0.8",
        "@types/validator": "^13.15.10",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
