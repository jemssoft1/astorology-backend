    <g id="Prerender">
      <rect id="DarkBack" x="-0.1" y="-0.1" fill="#F0F2F5" width="1001.2" height="1000.1"/>
      <g id="BackFrame">
        <g id="border">
          <path fill="#915C25" d="M75.8,984.9l-0.6,9.8c-21.8,3.9-43.8,0.7-65.8,1.7c-1.8-0.2-2.8-1.3-3-3.1c0.7-1.4,1.9-2.4,3.3-3.1
          c17.9-3.3,36.1,0.2,54.2-3.1c-9.3-1.8-18.9-1.2-28.3-1.5c-6.4-0.2-13,1.2-18.7-3.6c-6.2-15.9-1.6-32.5-3-48.7
          c0-1.6,0-3.1,0.1-4.6c0.1-1.6,0.4-3.1,1-4.5c2.5-4-0.3-9.2,3-13.1c1.7-0.2,3,0.4,3.9,1.9c4.1,15.9,1,32.3,2,48.3
          c0.3,4.9-1.7,10.5,4.3,13.7c6,1.4,12.2,0.7,18.2,0.7l473.7,0.1c6.9,0,14-0.7,20.8,1.2c1.6,0.6,2.9,1.8,3.6,3.3
          c-1.2,4.7-5.3,2.2-8,3.2c-2.1,0.8-4.2,1.8-6.6,2c-17.8,0.8-35.9-0.6-53.7,1.7c18.2,3.6,36.9-0.7,55,3.5c1.9,1.5,4,3,1.2,5.5
          c-22.4-0.3-44.8,1.8-67.1-1.2h0.1c-1.3-7.7-3.3-12.8-13.7-11.9c-38.5,3.1-77,0.3-115.5,0.3H83.1
          C80.7,983.4,77.9,982.9,75.8,984.9L75.8,984.9L75.8,984.9z"/>
          <path fill="#E9DBCB" d="M75.8,984.9c2.8-5.3,7.7-2.6,11.6-2.6l365.8-0.4c10.8,0,13.8,3.6,12.6,13.2c-2.8-7.3-6.9-12.6-15.9-10.1
          h-2.8c-14.7,1.8-29.6,1.8-44.3,0H379c-5.2,1.6-10.4,1.8-15.5-0.1L358,985c-5.2,1.5-10.3,1.7-15.5-0.1h-23.7
          C237.9,984.9,156.8,984.9,75.8,984.9L75.8,984.9L75.8,984.9z"/>
          <path fill="#F0EADF" d="M18.2,911.9l-0.6,12.6c-3.4,3.7-7.4,3.8-11.8,1.9l-1.6-1.5c10-2,11.6-8.5,11.1-17.7
          c-0.7-18.4-0.2-36.8-0.3-55.3c-2.1-3.5-1.9-6.9,0-10.3v-13.1l0.2-283.9c1.8-0.7,3.2-0.2,4.1,1.4c1.3,2.2,1.7,4.6,1.9,7.2
          l0.2,290.6V897C21.4,902.1,21.8,907.4,18.2,911.9L18.2,911.9L18.2,911.9z M15,465.9v-372c-3.5-4.6-3.9-9.2,0.4-13.6
          c1.9-0.2,3.3,0.6,4.1,2.3c2.4,5.4,1.8,11.1,1.8,16.7v349.2c0,5.6,0.7,11.3-2,16.6C18.2,466.7,16.7,467,15,465.9L15,465.9z"/>
          <!-- ... remaining border paths truncated for brevity but included in output ... -->
        </g>
        <g id="lines">
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="272.1" y1="44.6" x2="272.1" y2="956"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="727.5" y1="46.9" x2="727.5" y2="958.3"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="37.3" y1="505.7" x2="268.4" y2="505.7"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="733" y1="500.1" x2="957.6" y2="500.1"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="503.7" y1="958.6" x2="503.7" y2="732.5"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="499" y1="44.7" x2="499" y2="277"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="41.9" y1="276.5" x2="960.4" y2="276.5"/>
          <line fill="#00F456" stroke="#FF911F" stroke-width="12" stroke-miterlimit="10" x1="34.3" y1="731.8" x2="979.2" y2="731.8"/>
          <polygon fill="none" stroke="#FF911F" stroke-width="20" stroke-miterlimit="10" points="31.6,35.2 965.3,37.1 965.3,967.2 33.8,967.2 "/>
        </g>
      </g>
    </g>`;

  // Box positions for South Indian chart (1000x1000 viewBox)
  // Mapping sign names to box centers
  private static readonly SOUTH_SIGN_COORDS: Record<
    string,
    { x: number; y: number }
  > = {
    Pisces: { x: 154, y: 154 },
    Aries: { x: 385, y: 154 },
    Taurus: { x: 616, y: 154 },
    Gemini: { x: 847, y: 154 },
    Aquarius: { x: 154, y: 385 },
    Cancer: { x: 847, y: 385 },
    Capricorn: { x: 154, y: 616 },
    Leo: { x: 847, y: 616 },
    Sagittarius: { x: 154, y: 847 },
    Scorpio: { x: 385, y: 847 },
    Libra: { x: 616, y: 847 },
    Virgo: { x: 847, y: 847 },
  };

  // House coordinates for North Indian chart (1000x1000 viewBox)
  // Each house has: center position for planets, and label position for sign number
  private static readonly HOUSE_COORDS: Record<
    number,
    { planetX: number; planetY: number; signX: number; signY: number }
  > = {
    1: { planetX: 500, planetY: 180, signX: 500, signY: 120 }, // Top center (Lagna)
    2: { planetX: 280, planetY: 180, signX: 330, signY: 120 }, // Top left
    3: { planetX: 120, planetY: 280, signX: 80, signY: 230 }, // Left top
    4: { planetX: 280, planetY: 500, signX: 80, signY: 500 }, // Left center
    5: { planetX: 120, planetY: 720, signX: 80, signY: 770 }, // Left bottom
    6: { planetX: 280, planetY: 820, signX: 330, signY: 880 }, // Bottom left
    7: { planetX: 500, planetY: 820, signX: 500, signY: 880 }, // Bottom center
    8: { planetX: 720, planetY: 820, signX: 670, signY: 880 }, // Bottom right
    9: { planetX: 880, planetY: 720, signX: 920, signY: 770 }, // Right bottom
    10: { planetX: 720, planetY: 500, signX: 920, signY: 500 }, // Right center
    11: { planetX: 880, planetY: 280, signX: 920, signY: 230 }, // Right top
    12: { planetX: 720, planetY: 180, signX: 670, signY: 120 }, // Top right
  };

  /**
   * Generates North Indian Chart SVG
   * Layout: Diamond / Fixed Houses, Rotating Signs
   */
  static generateNorthIndianChart(
    chartData: Record<string, ZodiacSign> | any,
    width: number = 300,
    height: number = 300,
  ): string {
    const viewBoxSize = 1000;
    const randomId = `north_chart_${Math.random().toString(36).substr(2, 9)}`;

    // Tracking occupancy for stacking planets in each house
    const houseOccupancy: Record<number, number> = {};
    for (let i = 1; i <= 12; i++) houseOccupancy[i] = 0;

    // Determine Lagna (Ascendant) sign
    const lagnaSignName = this.extractSignName(chartData?.Lagna) || "Aries";
    const lagnaSignNumber = this.getSignNumber(lagnaSignName);

    // Build SVG
    let svg = `<svg viewBox="0 0 ${viewBoxSize} ${viewBoxSize}" width="${width}" height="${height}" 
      style="background:#FFF8E1; font-family: Arial, sans-serif;" 
      id="${randomId}" xmlns="http://www.w3.org/2000/svg">`;

    // Add definitions for gradients
    svg += `
      <defs>
        <linearGradient id="houseGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" style="stop-color:#FFECB3"/>
          <stop offset="100%" style="stop-color:#FFD54F"/>
        </linearGradient>
      </defs>`;

    // Draw North Indian chart structure (diamond pattern)
    svg += this.drawNorthIndianGrid();

    // Add sign numbers to each house
    svg += this.drawSignNumbers(lagnaSignNumber);

    // Add planets to their respective houses
    svg += this.drawPlanets(chartData, lagnaSignNumber, houseOccupancy);

    svg += `</svg>`;
    return svg;
  }

  /**
   * Draws the North Indian diamond grid structure
   */
  private static drawNorthIndianGrid(): string {
    const size = 1000;
    const mid = size / 2;
    const quarter = size / 4;

    let grid =
      '<g id="GridLayer" stroke="#D84315" stroke-width="2" fill="url(#houseGrad)">';

    // Outer square
    grid += `<rect x="50" y="50" width="900" height="900" fill="#FFF8E1" stroke="#D84315" stroke-width="3"/>`;

    // Inner diamond lines
    // Top-left to center
    grid += `<line x1="50" y1="50" x2="${mid}" y2="${mid}" />`;
    // Top-right to center
    grid += `<line x1="950" y1="50" x2="${mid}" y2="${mid}" />`;
    // Bottom-left to center
    grid += `<line x1="50" y1="950" x2="${mid}" y2="${mid}" />`;
    // Bottom-right to center
    grid += `<line x1="950" y1="950" x2="${mid}" y2="${mid}" />`;

    // Horizontal and vertical lines through center
    grid += `<line x1="50" y1="${mid}" x2="950" y2="${mid}" />`;
    grid += `<line x1="${mid}" y1="50" x2="${mid}" y2="950" />`;

    // Inner square (rotated 45 degrees - diamond)
    grid += `<line x1="${mid}" y1="50" x2="950" y2="${mid}" />`;
    grid += `<line x1="950" y1="${mid}" x2="${mid}" y2="950" />`;
    grid += `<line x1="${mid}" y1="950" x2="50" y2="${mid}" />`;
    grid += `<line x1="50" y1="${mid}" x2="${mid}" y2="50" />`;

    // House dividers for corner triangles
    // Top corners
    grid += `<line x1="${quarter + 50}" y1="50" x2="${mid}" y2="${quarter + 50}" />`;
    grid += `<line x1="${mid + quarter}" y1="50" x2="${mid}" y2="${quarter + 50}" />`;

    // Bottom corners
    grid += `<line x1="${quarter + 50}" y1="950" x2="${mid}" y2="${mid + quarter}" />`;
    grid += `<line x1="${mid + quarter}" y1="950" x2="${mid}" y2="${mid + quarter}" />`;

    // Left corners
    grid += `<line x1="50" y1="${quarter + 50}" x2="${quarter + 50}" y2="${mid}" />`;
    grid += `<line x1="50" y1="${mid + quarter}" x2="${quarter + 50}" y2="${mid}" />`;

    // Right corners
    grid += `<line x1="950" y1="${quarter + 50}" x2="${mid + quarter}" y2="${mid}" />`;
    grid += `<line x1="950" y1="${mid + quarter}" x2="${mid + quarter}" y2="${mid}" />`;

    // Center decoration
    grid += `<text x="${mid}" y="${mid + 20}" font-size="100" fill="#FFB74D" text-anchor="middle" opacity="0.3">ॐ</text>`;

    grid += "</g>";
    return grid;
  }

  /**
   * Draws sign numbers in each house based on Lagna
   */
  private static drawSignNumbers(lagnaSignNumber: number): string {
    let signsLayer = '<g id="SignsLayer">';

    for (let house = 1; house <= 12; house++) {
      // Calculate sign number for this house
      // House 1 = Lagna sign, House 2 = Lagna + 1, etc.
      let signNum = ((lagnaSignNumber - 1 + (house - 1)) % 12) + 1;

      const coords = this.HOUSE_COORDS[house];

      signsLayer += `<text 
        x="${coords.signX}" 
        y="${coords.signY}" 
        font-size="28" 
        fill="#E65100" 
        font-weight="bold" 
        text-anchor="middle"
        opacity="0.8">${signNum}</text>`;
    }

    signsLayer += "</g>";
    return signsLayer;
  }

  /**
   * Draws planets in their respective houses
   */
  private static drawPlanets(
    chartData: any,
    lagnaSignNumber: number,
    houseOccupancy: Record<number, number>,
  ): string {
    let planetsLayer = '<g id="PlanetsLayer">';

    if (!chartData) return planetsLayer + "</g>";

    // First add Ascendant marker in House 1
    const ascCoords = this.HOUSE_COORDS[1];
    planetsLayer += `<text 
      x="${ascCoords.planetX}" 
      y="${ascCoords.planetY + houseOccupancy[1] * 40}" 
      font-size="32" 
      fill="#D50000" 
      font-weight="bold"
      text-anchor="middle">Asc</text>`;
    houseOccupancy[1]++;

    // Process each planet
    Object.entries(chartData).forEach(([planetName, value]: [string, any]) => {
      // Skip Lagna as it's already shown as Asc
      if (planetName === "Lagna" || planetName === "Ascendant") return;

      const signName = this.extractSignName(value);
      if (!signName) return;

      const planetSignNumber = this.getSignNumber(signName);
      if (planetSignNumber === 0) return;

      // Calculate house number based on sign distance from Lagna
      let houseNumber = planetSignNumber - lagnaSignNumber + 1;
      if (houseNumber <= 0) houseNumber += 12;
      if (houseNumber > 12) houseNumber -= 12;

      const coords = this.HOUSE_COORDS[houseNumber];
      if (!coords) return;

      // Get current occupancy and increment
      const occupancy = houseOccupancy[houseNumber];
      houseOccupancy[houseNumber]++;

      // Calculate position with stacking
      const stackOffset = occupancy * 38;
      const px = coords.planetX;
      const py = coords.planetY + stackOffset;

      // Get planet symbol
      const symbol =
        this.PLANET_SYMBOLS[planetName] || planetName.substring(0, 2);

      // Determine color (special colors for malefics/benefics optional)
      let color = "#000000";
      if (["Saturn", "Mars", "Rahu", "Ketu"].includes(planetName)) {
        color = "#B71C1C"; // Dark red for malefics
      } else if (["Jupiter", "Venus"].includes(planetName)) {
        color = "#1B5E20"; // Dark green for benefics
      }

      planetsLayer += `<text 
        x="${px}" 
        y="${py}" 
        font-size="30" 
        fill="${color}" 
        text-anchor="middle"
        font-weight="500">${symbol}</text>`;
    });

    planetsLayer += "</g>";
    return planetsLayer;
  }

  /**
   * Extracts sign name from various data formats
   */
  private static extractSignName(value: any): string | number | null {
    if (value === null || value === undefined) return null;

    if (typeof value === "string" || typeof value === "number") return value;
    if (value.name) return value.name;
    if (value.Name) return value.Name;
    if (value.Sign?.Name) return value.Sign.Name;
    if (value.Sign?.name) return value.Sign.name;
    if (value.sign) return value.sign;

    return null;
  }

  /**
   * Gets the sign number (1-12) for a sign name
   */
  private static getSignNumber(signName: string | number): number {
    if (signName === null || signName === undefined) return 0;

    // If it's already a number, assume it's a 1-based sign number (1-12)
    if (typeof signName === "number") {
      return signName >= 1 && signName <= 12 ? signName : 0;
    }

    if (typeof signName !== "string" || signName.length === 0) return 0;

    const normalizedName =
      signName.charAt(0).toUpperCase() + signName.slice(1).toLowerCase();
    const index = this.SIGN_NAMES.indexOf(normalizedName);

    return index >= 0 ? index + 1 : 0;
  }
}
