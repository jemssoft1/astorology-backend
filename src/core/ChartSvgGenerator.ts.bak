import { ZodiacSign } from "../types/interfaces";

export class ChartSvgGenerator {
  /**
   * Generates South Indian Chart SVG
   * Layout: Fixed Signs, Clockwise
   */
  static generateSouthIndianChart(
    chartData: any,
    width: number = 300,
    height: number = 300,
  ): string {
    const viewBoxSize = 1000;
    const randomId = `south_chart_${Math.random().toString(36).substr(2, 9)}`;

    // Tracking occupancy for stacking planets in each sign box
    const signOccupancy: Record<string, number> = {};
    this.SIGN_NAMES.forEach((name) => (signOccupancy[name] = 0));

    let svg = `<svg viewBox="0 0 ${viewBoxSize} ${viewBoxSize}" width="${width}" height="${height}" 
      style="background:#f0f2f5; font-family: Arial, sans-serif;" 
      id="${randomId}" xmlns="http://www.w3.org/2000/svg">`;

    // 1. Static Layout
    svg += this.SOUTH_INDIAN_BACKGROUND;

    // 2. Signs/Zodiac Layer (complex paths from C#) - Mocked for now due to truncated snippet
    svg += '<g id="SignLayer" opacity="0.3">';
    // ... (This would be where AQUARIUS, PISCES, etc. paths go)
    svg += "</g>";

    // 3. Data Layer (Planets)
    svg += this.drawSouthIndianPlanets(chartData, signOccupancy);

    svg += `</svg>`;
    return svg;
  }

  private static drawSouthIndianPlanets(
    chartData: any,
    signOccupancy: Record<string, number>,
  ): string {
    let planetsLayer = '<g id="PlanetsLayer">';
    if (!chartData) return planetsLayer + "</g>";

    Object.entries(chartData).forEach(([planetName, value]: [string, any]) => {
      const signName = this.extractSignName(value);
      if (!signName || !this.SIGN_NAMES.includes(String(signName))) return;

      const normalizedSign = String(signName);
      const coords = this.SOUTH_SIGN_COORDS[normalizedSign];
      if (!coords) return;

      const occupancy = signOccupancy[normalizedSign];
      signOccupancy[normalizedSign]++;

      // 3x3 layout within each sign box (approx 230x230px)
      const cols = 2;
      const col = occupancy % cols;
      const row = Math.floor(occupancy / cols);

      const dx = coords.x - 70 + col * 100;
      const dy = coords.y - 70 + row * 60;

      const symbol =
        this.PLANET_SYMBOLS[planetName] || planetName.substring(0, 2);
      let color =
        planetName === "Asc" || planetName === "Lagna" ? "#D50000" : "#000000";

      if (["Saturn", "Mars", "Rahu", "Ketu"].includes(planetName))
        color = "#B71C1C";
      else if (["Jupiter", "Venus"].includes(planetName)) color = "#1B5E20";

      planetsLayer += `<text x="${dx}" y="${dy}" font-size="34" fill="${color}" text-anchor="middle" font-weight="bold">${symbol}</text>`;
    });

    planetsLayer += "</g>";
    return planetsLayer;
  }

  // Sign names in order (1-12)
  private static readonly SIGN_NAMES = [
    "Aries",
    "Taurus",
    "Gemini",
    "Cancer",
    "Leo",
    "Virgo",
    "Libra",
    "Scorpio",
    "Sagittarius",
    "Capricorn",
    "Aquarius",
    "Pisces",
  ];

  // Planet symbols mapping
  private static readonly PLANET_SYMBOLS: Record<string, string> = {
    Sun: "Su",
    Moon: "Mo",
    Mars: "Ma",
    Mercury: "Me",
    Jupiter: "Ju",
    Venus: "Ve",
    Saturn: "Sa",
    Rahu: "Ra",
    Ketu: "Ke",
    Ascendant: "Asc",
    Lagna: "Asc",
  };

